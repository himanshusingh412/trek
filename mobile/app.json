{
  "expo": {
    "name": "Sahyātri",
    "slug": "sahyatri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sahyatri",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#143626"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sahyatri.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Sahyātri requires camera access to take profile photos and document uploads.",
        "NSPhotoLibraryUsageDescription": "Sahyātri requires photo library access to select profile photos and medical certificates.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#143626"
      },
      "package": "com.sahyatri.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "INTERNET",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#143626",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "sahyatri-mobile-app"
      }
    }
  }
}
