# Copy to .env — never commit real secrets. Comments go on their own line: the backend reads this file as Java
# .properties, where a # after a value becomes part of the value. Every variable per environment (dev / staging / production), with what's
# secret and what's required: docs/ENVIRONMENT.md. Values marked [secret] come from AWS Secrets Manager when deployed.

# Production (AWS) values are noted as "prod:". Secrets live in AWS Secrets Manager, never here.

# Database (docker-compose + backend)
DB_NAME=sahyatri
DB_USER=sahyatri
# [secret] in every deployed environment; this compose default is refused there
DB_PASSWORD=sahyatri
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/sahyatri
DB_POOL_SIZE=10

# Environment: development | staging | production. staging/production refuse to start on missing or development
# settings (log email/SMS, local storage, placeholder JWT secret, http/localhost URLs, …) and list what to fix
# without printing values. Live Razorpay keys only run in production; test keys only outside it.
APP_ENV=development

# Backend
PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth (backend)
# [secret] openssl rand -base64 48. This placeholder is refused outside development.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
AUTH_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=

# URLs, uploads, mail (backend)
PUBLIC_BASE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:5173
# Uploads: local (dev) or s3 (prod, bucket in AWS_REGION; credentials from the ECS task role)
STORAGE_TYPE=local
UPLOAD_DIR=./data/uploads
S3_UPLOADS_BUCKET=
AWS_REGION=ap-south-1
# Email: log (dev, printed to the console) or ses (prod; MAIL_FROM's domain must be verified in SES)
MAIL_PROVIDER=log
# MAIL_FROM defaults to "The Empty Valley <no-reply@sahyatri.local>" (application.yml). If you set it, don't quote
# it — the backend reads this file as .properties — and don't `source` the file in a shell.
# MAIL_FROM=The Empty Valley <no-reply@sahyatri.local>

# OTP SMS: log (dev only: codes printed), msg91 (needs TRAI DLT-approved sender + OTP template using ##otp##),
# or disabled (deployed sites until SMS delivers: OTP requests answer 503 SMS_UNAVAILABLE, no code is created)
SMS_PROVIDER=log
# [secret]
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Rate limits (backend). prod: RATE_LIMIT_CLIENT_IP_HEADER=X-Forwarded-For behind the ALB (CloudFront-Viewer-Address on CloudFront)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CLIENT_IP_HEADER=

# Admin & catalog (backend)
ADMIN_EMAILS=
GUIDE_SHARE_BPS=7000
# Charity share of every booking, taken out of the price (never added on top). Blank name hides it on the trek page.
CHARITY_NAME=
CHARITY_BPS=100

# Bookings & payments (backend) — Razorpay test keys (rzp_test_) in development and staging, live keys (rzp_live_)
# only with APP_ENV=production. Blank = payments off. Only the key id ever reaches a browser.
BOOKING_HOLD_TTL=10m
RAZORPAY_KEY_ID=
# [secret]
RAZORPAY_KEY_SECRET=
# [secret] required with the keys when deployed
RAZORPAY_WEBHOOK_SECRET=

# Frontend (Vite). Everything VITE_ is public: it's compiled into the site's JavaScript. Never put a secret here.
# prod: https://api.theemptyvalley.com (Firebase Hosting); empty once on CloudFront (same origin)
VITE_API_BASE_URL=http://localhost:8081
VITE_GOOGLE_CLIENT_ID=
# true shows phone-OTP sign-in; leave off until SMS delivers (SMS_PROVIDER=msg91 after DLT)
VITE_PHONE_OTP=
# Production builds fail while frontend/src/lib/business.ts has [placeholders]; set true only to build anyway (never for launch)
# ALLOW_PLACEHOLDER_BUSINESS_DETAILS=
